{
  "name": "flashfirm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-first temporary agent teams with reproducible contribution allocation",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node scripts/build-wallet.mjs && node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test",
    "test:http": "node scripts/check-http.mjs",
    "test:sandbox": "node scripts/check-sandbox.mjs",
    "build:contract": "node scripts/build-contract.mjs",
    "build:wallet": "node scripts/build-wallet.mjs",
    "operator:token": "node scripts/operator-token.mjs",
    "mainnet:console": "node scripts/mainnet-console.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "model:probe": "node scripts/probe-models.mjs",
    "live:run": "node scripts/run-live.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "overrides": {
    "tar": "7.5.22",
    "nanoid": "5.1.16",
    "decode-uri-component": "0.5.1"
  },
  "devDependencies": {
    "@meteorwallet/sdk": "3.24.1",
    "@near-js/transactions": "1.3.3",
    "@near-wallet-selector/core": "10.1.4",
    "@near-wallet-selector/my-near-wallet": "10.1.4",
    "buffer": "6.0.3",
    "esbuild": "0.28.2",
    "meteor-crypto": "npm:@near-js/crypto@2.2.5",
    "meteor-transactions": "npm:@near-js/transactions@2.2.5",
    "near-api-js": "5.1.1",
    "near-workspaces": "5.0.0",
    "util": "0.12.5"
  },
  "dependencies": {
    "@defuse-protocol/one-click-sdk-typescript": "0.1.26"
  }
}
